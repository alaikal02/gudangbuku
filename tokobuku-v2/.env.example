# ==============================================================================
# Environment Configuration for Tokobuku Darussholah (Cloudflare D1 & Container)
# Inject these variables into your Cloudflare Pages / Workers or Docker Environment
# ==============================================================================

# Application Port & Host
PORT=8000
HOST=0.0.0.0

# Cloudflare D1 SQLite Database Credentials
# Obtain these from Cloudflare Dashboard -> Storage & Databases -> D1
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permissions

# Database Timeout in seconds (Default: 6.0)
D1_TIMEOUT=6.0
