# ==============================================================================
# Environment Configuration for Tokobuku Darussholah
# Inject these variables into your Cloudflare Project Settings or Docker Environment
# ==============================================================================

# Application Port (Default: 8000)
PORT=8000
HOST=0.0.0.0

# Supabase Production PostgreSQL Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here

# Database Timeout in seconds (Default: 8.0)
DB_TIMEOUT=8.0
